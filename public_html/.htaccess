# ============================================================
# Puresol — Apache Configuration (SEO-optimized)
# Agrigore Ventures Pvt. Ltd.
# ============================================================

# ---- Charset ----------------------------------------------
AddDefaultCharset UTF-8

# ---- Default Index Files ----------------------------------
DirectoryIndex index.html index.php

# ---- Disable Directory Listing ----------------------------
Options -Indexes

# ---- Custom Error Pages -----------------------------------
ErrorDocument 404 /404.html

# ---- Enable URL Rewriting ---------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Force non-www (canonical: puresol.in) — important for SEO
    RewriteCond %{HTTP_HOST} ^www\.puresol\.in$ [NC]
    RewriteRule ^(.*)$ https://puresol.in/$1 [L,R=301]

    # Remove trailing slashes from non-directory URLs
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Clean URLs for blog/journal posts: /blog/<slug> -> post.php?slug=<slug>
    # (Runs before the generic .html fallback; does not affect /blog.html.)
    RewriteRule ^blog/([a-z0-9-]+)/?$ post.php?slug=$1 [L,QSA]

    # Allow access to /story (without .html) by internally rewriting to /story.html
    # This is a friendly addition — does NOT force redirect, keeps canonical .html URLs
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ---- Block Access to Sensitive Files ----------------------
<FilesMatch "(^\.htaccess|^\.env|^\.git|composer\.(json|lock)|package(-lock)?\.json|\.sql|\.log|\.md)$">
    Require all denied
</FilesMatch>

<Files "config.php">
    Require all denied
</Files>
<Files "setup.sql">
    Require all denied
</Files>

# ---- Block Access to Protected Directories ----------------
RedirectMatch 403 ^/logs(/|$)
RedirectMatch 403 ^/includes(/|$)
RedirectMatch 403 ^/scripts(/|$)

# ---- Allow access to robots.txt, sitemap.xml, .well-known ----
<Files "robots.txt">
    Require all granted
</Files>
<Files "sitemap.xml">
    Require all granted
</Files>

# ---- Security & SEO Headers -------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
    Header set X-Robots-Tag "index, follow, max-image-preview:large, max-snippet:-1"

    # Remove server fingerprinting
    Header unset Server
    Header unset X-Powered-By

    # Cache Control for static assets (long cache)
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf)$">
        Header set Cache-Control "public, max-age=15552000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(html|xml)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # Apply X-Robots-Tag to XML/HTML only (not to JS/CSS/images)
    <FilesMatch "\.(html|xml)$">
        Header set X-Robots-Tag "index, follow, max-image-preview:large"
    </FilesMatch>
</IfModule>

# ---- MIME Types -------------------------------------------
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType image/avif .avif
    AddType application/font-woff2 .woff2
    AddType application/manifest+json .webmanifest
    AddType application/xml .xml
    AddType text/plain .txt
</IfModule>

# ---- Browser Caching --------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 month"
    ExpiresByType text/html                 "access plus 1 hour"
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType image/jpeg                "access plus 6 months"
    ExpiresByType image/png                 "access plus 6 months"
    ExpiresByType image/webp                "access plus 6 months"
    ExpiresByType image/avif                "access plus 6 months"
    ExpiresByType image/svg+xml             "access plus 6 months"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/xml           "access plus 1 day"
    ExpiresByType application/rss+xml       "access plus 1 hour"
    ExpiresByType application/atom+xml      "access plus 1 hour"
</IfModule>

# ---- Compression (GZIP + Brotli) --------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE application/rss+xml application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff font/ttf font/otf
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/woff2 font/woff
</IfModule>

# ---- ETag Disable (let Cache-Control + Last-Modified handle) ----
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None
